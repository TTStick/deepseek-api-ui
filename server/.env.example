# 环境变量说明：compose 从项目根目录的 .env 读取（而非本文件）。
# 本文件仅列出变量名与默认值，实际配置请编辑 ../.env：

# DeepSeek 凭据：浏览器未带 apiKey 时的兜底（压缩摘要、查询改写共用），
# 同时也是 Honcho deriver 后台推理的 LLM 凭据。
DEEPSEEK_API_KEY=
DEEPSEEK_API_ORIGIN=https://api.deepseek.com

# Honcho 自托管地址（compose 内服务名）与凭据。
# 本地自托管时 API key 可以是任意值（Honcho 本地不校验，见 honcho 文档）。
HONCHO_BASE_URL=http://honcho-api:8000
HONCHO_API_KEY=local
HONCHO_ENVIRONMENT=local

# 后端监听端口
PORT=3000

# 访问密码：
# - 本地/局域网可留空，首次打开后可在网页设置里设置；
# - 公网部署务必设置强密码（至少 10 位，建议 16 位以上），并同时设 REQUIRE_AUTH=true
ACCESS_PASSWORD=
REQUIRE_AUTH=false

# 允许跨域访问的来源（逗号分隔）。手机 WebView 默认来源已内置；
# 如果 Web 前端与 API 不同源，把 Web 的 Origin 加到这里，例如 https://agent.example.com
CORS_ORIGINS=

# 限速与 SSRF：
# - TRUST_PROXY=true 表示只经 nginx/Caddy 暴露，按 X-Forwarded-For 识别客户端；
#   若直接暴露 server 端口必须设为 false（否则可伪造 XFF 绕过登录限速）。
# - SSH_ALLOW_PRIVATE_HOSTS=false 时禁止 SSH 工具连接内网/回环/云元数据地址；
#   需要连局域网机器时再设为 true。
# - CHAT_RATE_LIMIT_PER_MINUTE 控制单客户端每分钟聊天/压缩请求数。
TRUST_PROXY=true
SSH_ALLOW_PRIVATE_HOSTS=false
CHAT_RATE_LIMIT_PER_MINUTE=30
ALLOWED_MODELS=deepseek-flash,deepseek-v4-pro

# 公网 HTTPS（docker compose --profile prod --profile public）
PUBLIC_DOMAIN=
ACME_EMAIL=
